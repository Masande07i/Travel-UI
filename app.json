
{
  "expo": {
    "name": "Travel-UI",
    "slug": "Travel-UI",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "travelui",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.masandem.TravelUI"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "26257b26-00b0-4f01-8b5e-86ae7cd3f170"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26257b26-00b0-4f01-8b5e-86ae7cd3f170"
    }
  }
}
